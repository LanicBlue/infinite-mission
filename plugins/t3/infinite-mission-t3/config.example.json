{
  "imBin": "/Users/lanic/.local/bin/im",
  "t3": {
    "bin": ["node", "/opt/homebrew/lib/node_modules/t3/dist/bin.mjs"],
    "home": "~/.t3",
    "label": "im-t3-bridge",
    "tokenTtl": "30d"
  },
  "receiveTimeoutSec": 600,
  "rescanSec": 60,
  "maxDeliverAttempts": 10,
  "admin": { "listen": "127.0.0.1:4770", "enabled": true },
  "workspaces": null,
  "members": [
    {
      "id": "t3-codex",
      "instance": "codex",
      "model": "gpt-5.6-luna",
      "runtimeMode": "full-access"
    },
    {
      "id": "t3-claude",
      "instance": "claudeAgent",
      "model": "claude-sonnet-5",
      "runtimeMode": "full-access",
      "enabled": false
    }
  ]
}
